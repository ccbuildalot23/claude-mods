# Pinned versions for the LaBeau media toolkit (checked Oct 24, 2026 against each official source).
# Change a pin only with Chris's yes, then log it (Changes row + registers).
CCUSAGE=20.0.40            # npm ccusage (MIT), the pin in harness-addons-v2 step 3
CCSTATUSLINE=2.2.32        # npm ccstatusline (MIT), github.com/sirmalloc/ccstatusline
SKILLS=1.7.4               # npm skills (MIT), Vercel Labs, skills.sh; search only
PLUGINS_REPO=anthropics/claude-plugins-official
PLUGINS_COMMIT=58267944f92187b7d6a1c822165c96c81c864806   # hookify + security-guidance 2.0.16 at this commit
FIND_SKILLS_REPO=vercel-labs/skills
FIND_SKILLS_COMMIT=a80e4c9d12d607631249d4d7d059f835d4b2f13a
NODE_FORMULA=node@24       # Node.js 24 LTS (Homebrew); hyperframes, skills and Remotion need 22.20+
PYTHON_FORMULA=python@3.13 # Python 3.13 (Homebrew); security-guidance prefers 3.13
# ffmpeg and gh come from Homebrew and are held with `brew pin` at the version installed; the run log records it.
# Puppeteer 25.16.0, Remotion 4.0.538, HyperFrames 0.8.191, GSAP 3.15.0, React 18.3.1: package.json + package-lock.json.
